// Design tokens, identical to the Tauri app's Tailwind theme.

/// What differs between operating systems (set from Rust at start).
export global Platform {
    /// macOS: window buttons on the left, ⌘ in shortcut labels.
    in property <bool> mac;
    /// Name of the shortcut modifier key.
    out property <string> mod: root.mac ? "⌘" : "Ctrl";
}

export global Theme {
    out property <color> app: #0d0d10;
    out property <color> panel: #17171b;
    out property <color> raised: #212126;
    out property <color> hover: #2a2a30;
    out property <color> line: #27272d;
    out property <color> line-strong: #3a3a42;
    out property <color> fg: #ececf1;
    out property <color> muted: #a0a0ab;
    out property <color> faint: #6c6c78;
    out property <color> accent: #6b97e8;
    out property <color> accent-hover: #82a8ee;
    out property <color> accent-ink: #ffffff;
    out property <color> danger: #f0606b;
    out property <color> warn: #e9b44c;
    out property <color> ok: #4fd18b;
    /// Thin border of floating panels (white at 5%).
    out property <color> surface-border: #ffffff0d;

    out property <color> clip-video: #4f7cff;
    out property <color> clip-image: #8b6cf6;
    out property <color> clip-audio: #2fb38a;
    out property <color> clip-text: #e2a03f;
    out property <color> clip-shape: #d16ba5;

    out property <length> text-2xs: 12px;
    out property <length> text-xs: 13px;
    out property <length> text-sm: 14px;
    out property <length> text-lg: 18px;

    out property <length> radius-panel: 12px;
    out property <length> radius: 8px;
    out property <length> label-width: 96px;
    out property <duration> fast: 120ms;
}

